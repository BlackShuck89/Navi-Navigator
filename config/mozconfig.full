# Navi Navigator 0.1.0-alpha — independently branded Windows x64 Gecko source build.
# Requires a real Firefox source checkout and MozillaBuild bootstrap.
# Artifact mode uses upstream compiled binaries and is not used for standalone Navi.
ac_add_options --with-branding=browser/branding/navi
ac_add_options --with-app-basename=NaviNavigator
ac_add_options --with-app-name=navinavigator
ac_add_options --disable-debug
ac_add_options --enable-optimize
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-navi-gecko
mk_add_options AUTOCLOBBER=1
